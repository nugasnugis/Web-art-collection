<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#6f8cff">
  <meta name="description" content="A small collection of art, sketches, and creative works.">
  <title>Blue & Pink — Art Collection</title>

  <style>
    :root {
      --blue: #6f8cff;
      --blue-dark: #3f5fca;
      --blue-soft: #eaf0ff;
      --pink: #f39abb;
      --pink-soft: #fff0f6;
      --paper: #fffdfb;
      --ink: #26304a;
      --muted: #788198;
      --line: rgba(63, 95, 202, .12);
      --shadow: 0 24px 70px rgba(63, 95, 202, .13);
      --radius: 28px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 10% 5%, rgba(111,140,255,.15), transparent 28rem),
        radial-gradient(circle at 92% 15%, rgba(243,154,187,.17), transparent 25rem),
        var(--paper);
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .paper-texture {
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .22;
      z-index: -1;
      background-image:
        radial-gradient(rgba(38,48,74,.10) .7px, transparent .7px);
      background-size: 7px 7px;
      mask-image: linear-gradient(to bottom, black, transparent 80%);
    }

    /* NAVIGATION */
    nav {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1120px, calc(100% - 32px));
      padding: 13px 16px 13px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: rgba(255,253,251,.78);
      border: 1px solid rgba(255,255,255,.9);
      box-shadow: 0 12px 40px rgba(63,95,202,.10);
      backdrop-filter: blur(18px);
      border-radius: 999px;
      z-index: 50;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      letter-spacing: -.03em;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: white;
      background: linear-gradient(135deg, var(--blue), var(--pink));
      box-shadow: 0 6px 18px rgba(111,140,255,.28);
    }

    .nav-links {
      display: flex;
      gap: 24px;
      color: var(--muted);
      font-size: .9rem;
      font-weight: 600;
    }

    .nav-links a {
      transition: color .2s ease;
    }

    .nav-links a:hover {
      color: var(--blue-dark);
    }

    /* HERO */
    .hero {
      width: min(1120px, calc(100% - 32px));
      min-height: 100vh;
      margin: auto;
      padding: 150px 0 90px;
      display: grid;
      grid-template-columns: 1.02fr .98fr;
      align-items: center;
      gap: 70px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 13px;
      margin-bottom: 24px;
      border-radius: 999px;
      background: var(--blue-soft);
      color: var(--blue-dark);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 0 4px rgba(243,154,187,.18);
    }

    h1 {
      max-width: 700px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(3.6rem, 8vw, 7.2rem);
      line-height: .88;
      letter-spacing: -.075em;
      font-weight: 500;
    }

    h1 span {
      color: var(--blue);
      font-style: italic;
    }

    .hero-copy {
      max-width: 530px;
      margin-top: 28px;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 34px;
      flex-wrap: wrap;
    }

    .button {
      border: 0;
      cursor: pointer;
      padding: 14px 21px;
      border-radius: 999px;
      font-weight: 750;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .button-primary {
      color: white;
      background: var(--blue);
      box-shadow: 0 12px 25px rgba(111,140,255,.28);
    }

    .button-secondary {
      color: var(--blue-dark);
      background: white;
      border: 1px solid var(--line);
    }

    /* HERO ART */
    .hero-art {
      position: relative;
    }

    .art-frame {
      position: relative;
      padding: 15px;
      background: rgba(255,255,255,.82);
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 34px 34px 34px 8px;
      box-shadow: var(--shadow);
      transform: rotate(1.2deg);
    }

    .art-frame::before {
      content: "";
      position: absolute;
      width: 105px;
      height: 31px;
      top: -13px;
      left: 28px;
      background: rgba(243,154,187,.65);
      transform: rotate(-5deg);
      border-radius: 3px;
      z-index: 2;
    }

    .art-frame img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 23px 23px 23px 3px;
      filter: saturate(.82) contrast(.96);
    }

    .art-note {
      position: absolute;
      right: -35px;
      bottom: 25px;
      width: 135px;
      padding: 15px;
      color: var(--blue-dark);
      background: #fff;
      border: 1px solid var(--line);
      box-shadow: 0 16px 35px rgba(63,95,202,.13);
      transform: rotate(5deg);
      border-radius: 4px;
      font-family: "Comic Sans MS", "Segoe Print", cursive;
      font-size: .85rem;
      line-height: 1.45;
    }

    .art-note::after {
      content: "♡";
      display: block;
      color: var(--pink);
      font-size: 1.6rem;
      text-align: right;
      line-height: .7;
    }

    /* SECTION */
    section {
      width: min(1120px, calc(100% - 32px));
      margin: auto;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 34px;
    }

    .section-kicker {
      color: var(--pink);
      font-weight: 850;
      font-size: .75rem;
      letter-spacing: .13em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 500;
      font-size: clamp(2.4rem, 5vw, 4.2rem);
      letter-spacing: -.055em;
    }

    .section-description {
      max-width: 420px;
      color: var(--muted);
      line-height: 1.7;
    }

    /* GALLERY */
    .gallery {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 22px;
    }

    .art-card {
      grid-column: span 4;
      position: relative;
      overflow: hidden;
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 10px 35px rgba(63,95,202,.07);
      cursor: pointer;
      transition: transform .3s ease, box-shadow .3s ease;
    }

    .art-card:first-child {
      grid-column: span 8;
    }

    .art-card:hover {
      transform: translateY(-7px) rotate(-.4deg);
      box-shadow: 0 25px 60px rgba(63,95,202,.15);
    }

    .art-image {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--blue-soft);
    }

    .art-card:first-child .art-image {
      aspect-ratio: 16 / 10;
    }

    .art-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .5s ease;
    }

    .art-card:hover img {
      transform: scale(1.035);
    }

    .coming-soon {
      height: 100%;
      display: grid;
      place-items: center;
      color: var(--muted);
      background:
        linear-gradient(135deg, rgba(111,140,255,.08), rgba(243,154,187,.14)),
        white;
      font-family: Georgia, serif;
      font-style: italic;
      font-size: 1.25rem;
    }

    .art-info {
      padding: 18px 20px 21px;
    }

    .art-number {
      color: var(--pink);
      font-size: .7rem;
      font-weight: 850;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .art-title {
      margin-top: 6px;
      font-family: Georgia, serif;
      font-size: 1.35rem;
    }

    .art-meta {
      margin-top: 5px;
      color: var(--muted);
      font-size: .82rem;
    }

    /* ABOUT */
    .about {
      margin-top: 150px;
      margin-bottom: 150px;
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 80px;
      align-items: start;
    }

    .about-sticky {
      position: sticky;
      top: 120px;
    }

    .about-copy {
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.9;
      max-width: 650px;
    }

    .about-copy p + p {
      margin-top: 20px;
    }

    .signature {
      margin-top: 35px;
      color: var(--blue-dark);
      font-family: "Comic Sans MS", "Segoe Print", cursive;
      font-size: 1.25rem;
      transform: rotate(-3deg);
    }

    /* FOOTER */
    footer {
      margin-top: 100px;
      padding: 45px 20px;
      text-align: center;
      background: var(--blue);
      color: white;
    }

    footer .footer-title {
      font-family: Georgia, serif;
      font-size: 1.5rem;
    }

    footer p {
      margin-top: 8px;
      opacity: .78;
      font-size: .82rem;
    }

    /* LIGHTBOX */
    .lightbox {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 25px;
      background: rgba(20,27,48,.82);
      backdrop-filter: blur(12px);
      opacity: 0;
      visibility: hidden;
      transition: opacity .25s ease, visibility .25s ease;
      z-index: 100;
    }

    .lightbox.open {
      opacity: 1;
      visibility: visible;
    }

    .lightbox-inner {
      position: relative;
      max-width: min(1000px, 95vw);
      max-height: 90vh;
    }

    .lightbox img {
      display: block;
      max-width: 100%;
      max-height: 82vh;
      border-radius: 18px;
      box-shadow: 0 30px 100px rgba(0,0,0,.35);
    }

    .close {
      position: absolute;
      top: -48px;
      right: 0;
      width: 38px;
      height: 38px;
      border: 0;
      border-radius: 50%;
      cursor: pointer;
      background: white;
      color: var(--ink);
      font-size: 1.2rem;
    }

    /* REVEAL */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .7s ease, transform .7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: none;
    }

    @media (max-width: 800px) {
      nav {
        top: 10px;
      }

      .nav-links {
        display: none;
      }

      .hero {
        min-height: auto;
        padding-top: 125px;
        padding-bottom: 80px;
        grid-template-columns: 1fr;
        gap: 55px;
      }

      h1 {
        font-size: clamp(3.5rem, 17vw, 6rem);
      }

      .art-note {
        right: 5px;
      }

      .section-heading {
        display: block;
      }

      .section-description {
        margin-top: 15px;
      }

      .art-card,
      .art-card:first-child {
        grid-column: span 12;
      }

      .art-card:first-child .art-image,
      .art-image {
        aspect-ratio: 4 / 3;
      }

      .about {
        margin-top: 100px;
        margin-bottom: 100px;
        grid-template-columns: 1fr;
        gap: 35px;
      }

      .about-sticky {
        position: static;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <div class="paper-texture"></div>

  <nav>
    <a href="#" class="brand" aria-label="Home">
      <span class="brand-mark">✦</span>
      <span>art collection</span>
    </a>

    <div class="nav-links">
      <a href="#gallery">Gallery</a>
      <a href="#about">About</a>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div class="hero-content reveal">
        <div class="eyebrow">A little collection</div>

        <h1>
          Drawn with <span>feeling.</span>
        </h1>

        <p class="hero-copy">
          A personal corner for sketches, illustrations, and little pieces
          of art worth keeping. Simple, soft, and a little bit dreamy.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#gallery">View the collection ↓</a>
          <a class="button button-secondary" href="#about">About the artist</a>
        </div>
      </div>

      <div class="hero-art reveal">
        <div class="art-frame">
          <img
            src="data:image/png;base64,"
            alt="Pencil sketch of a character"
            loading="eager"
          >
        </div>

        <div class="art-note">
          first piece<br>
          pencil sketch
        </div>
      </div>
    </section>

    <section id="gallery" class="reveal">
      <div class="section-heading">
        <div>
          <div class="section-kicker">The archive</div>
          <h2>Selected works</h2>
        </div>

        <p class="section-description">
          More pieces can be added here later. For now, this is where
          the collection begins.
        </p>
      </div>

      <div class="gallery">
        <article
          class="art-card"
          data-title="Untitled Sketch"
          data-description="Pencil on paper"
        >
          <div class="art-image">
            <img
              src="data:image/png;base64,"
              alt="Pencil sketch of a character"
              loading="lazy"
            >
          </div>
          <div class="art-info">
            <div class="art-number">01 · sketch</div>
            <div class="art-title">Untitled Sketch</div>
            <div class="art-meta">Pencil on paper</div>
          </div>
        </article>

        <article class="art-card" aria-label="Future artwork placeholder">
          <div class="art-image">
            <div class="coming-soon">another piece, someday ♡</div>
          </div>
          <div class="art-info">
            <div class="art-number">02 · coming soon</div>
            <div class="art-title">Untitled</div>
            <div class="art-meta">Waiting for the next piece</div>
          </div>
        </article>

        <article class="art-card" aria-label="Future artwork placeholder">
          <div class="art-image">
            <div class="coming-soon">more art here ✦</div>
          </div>
          <div class="art-info">
            <div class="art-number">03 · coming soon</div>
            <div class="art-title">Untitled</div>
            <div class="art-meta">Waiting for the next piece</div>
          </div>
        </article>
      </div>
    </section>

    <section id="about" class="about reveal">
      <div class="about-sticky">
        <div class="section-kicker">About</div>
        <h2>The artist</h2>
      </div>

      <div class="about-copy">
        <p>
          This space is made to collect and preserve the artwork of a friend —
          from quick pencil sketches to whatever creative pieces come next.
        </p>

        <p>
          The design intentionally keeps plenty of white space around the
          artwork, with blue and pink accents inspired by the artist's
          favorite colors.
        </p>

        <div class="signature">made with ♡</div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-title">Keep creating.</div>
    <p>© 2026 · A small art collection</p>
  </footer>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Artwork preview">
    <div class="lightbox-inner">
      <button class="close" id="closeLightbox" aria-label="Close">×</button>
      <img id="lightboxImage" src="" alt="">
    </div>
  </div>

  <script>
    // Smooth reveal animations
    const reveals = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    reveals.forEach(el => observer.observe(el));

    // Artwork lightbox
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightboxImage");
    const closeLightbox = document.getElementById("closeLightbox");

    document.querySelectorAll(".art-card img").forEach(img => {
      img.closest(".art-card").addEventListener("click", () => {
        lightboxImage.src = img.src;
        lightboxImage.alt = img.alt;
        lightbox.classList.add("open");
        document.body.style.overflow = "hidden";
      });
    });

    function closePreview() {
      lightbox.classList.remove("open");
      document.body.style.overflow = "";
    }

    closeLightbox.addEventListener("click", closePreview);

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closePreview();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePreview();
    });
  </script>
</body>
</html>
